.DS_Store
**/.DS_Store
.RData
# WGCNA::modulePreservation drops permutedStats-*.RData checkpoints in the
# working directory; they are resumable scratch, not results.
*.RData
**/.Rhistory
**/.Rapp.history
.Rproj.user/

# Credentials
.Renviron
.httr-oauth
*.pem
*.key

.here
# Untracked leftovers only: 156 MB of renders and an archived targets store that
# git never held. Delete the directory to retire this rule.
archive/
~$*
*.tmp
*.log
Rplots.pdf
docs/

# proteoDA writes one boilerplate HTML report per contrast, 21 MB in all, and
# nothing reads them. The blanket *.html rule this replaces existed to hide
# rendered .qmd output, which no longer exists.
**/*_DA_report.html
**/*_files/
**/*_cache/

# Figure and QC renders are regenerated from the scripts; the data intermediates
# in c_data/ stay tracked so a clone builds figures without re-running upstream.
**/b_reports/**/*.png
**/b_reports/**/*.pdf

# 01_run_dep_imputed.R writes a combined_results_pi.csv for each arm. Only the
# missforest one is read again -- test-pi-score.R uses it as its equivalence
# fixture -- so it stays tracked. The other three are write-only and would just be
# 13 MB no clone reads. The QC figure reads the sensitivity and concordance
# summaries beside them, and the figures read DAList_imputed_missforest.rds.
03_DEP/b_imputed/c_data/imp4p/combined_results_pi.csv
03_DEP/b_imputed/c_data/mscoreutils/combined_results_pi.csv
03_DEP/b_imputed/c_data/perseus/combined_results_pi.csv

# t0: experimental targets prediction pipeline (WIP). Track the source and the
# outputs/ skeleton; the store and materialized outputs regenerate from tar_make().
t0/_targets/
t0/outputs/figures/*.png
t0/outputs/qc/*.csv
t0/outputs/results/*.csv
t0/outputs/session_info.txt

# Pre-split sweep leaves. run_* writes <level>/<config>/<model>/, split_*
# copies it to <level>/<config>/<phenotype>/<model>/ and never deletes the
# original -- that is what makes a killed run resumable via leaf_done().
# The two shapes differ only by depth, so each model name needs its own rule
# at the three-deep position. The split leaves (four deep) stay tracked.
05_Figures/F0*_*/*/*/limma/
05_Figures/F0*_*/*/*/lm/
05_Figures/F0*_*/*/*/spearman/
05_Figures/F0*_*/*/*/wilcoxon/
05_Figures/F0*_*/*/*/enet/
05_Figures/F0*_*/*/*/lasso/
05_Figures/F0*_*/*/*/ridge/
05_Figures/F0*_*/*/*/spls/
05_Figures/F0*_*/*/*/pam/
05_Figures/F0*_*/*/*/rf/
05_Figures/F0*_*/*/*/svm/
05_Figures/F0*_*/*/*/plain/
